<UserControl x:Class="BuildVisualizer.ToolWindow.BuildVisualizerToolWindowControl"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
			 xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
			 xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
			 xmlns:vm="clr-namespace:BuildVisualizer.ViewModels"
			 xmlns:views="clr-namespace:BuildVisualizer.Views"
			 xmlns:converters="clr-namespace:BuildVisualizer.Converters"
			 Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
			 Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
			 mc:Ignorable="d"
			 d:DesignHeight="300" d:DesignWidth="300"
			 d:DataContext="{d:DesignInstance Type=vm:BuildVisualizerViewModel}">
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
		<converters:InverseBooleanToVisibilityConverter x:Key="BoolToVisibilityInverseConverter"/>
		<converters:NullableTimeSpanConverter x:Key="NullableTimeSpanConverter"/>
		<converters:SortIndicatorVisibilityConverter x:Key="SortIndicatorVisibilityConverter"/>
		<converters:SortedCollectionConverter x:Key="SortByNameConverter" SortProperty="Name"/>

		<!-- Menu separator: a non-interactive MenuItem that renders as a themed line -->
		<Style x:Key="MenuSeparator" TargetType="MenuItem">
			<Setter Property="IsHitTestVisible" Value="False"/>
			<Setter Property="Focusable" Value="False"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate>
						<Border Height="1" Margin="2" SnapsToDevicePixels="true"
								Background="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarMenuBorderKey}}"/>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Resize gripper for column headers -->
		<Style x:Key="ColumnHeaderGripperStyle" TargetType="Thumb">
			<Setter Property="Width" Value="18"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Cursor" Value="SizeWE"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Thumb">
						<Border Background="{TemplateBinding Background}"/>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Column header style: VS-themed background, no OS hover effects -->
		<Style x:Key="SortableColumnHeaderStyle" TargetType="GridViewColumnHeader">
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Padding" Value="6,3"/>
			<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="GridViewColumnHeader">
						<Border x:Name="HeaderBorder"
								Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
								BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
								BorderThickness="0,0,1,1">
							<Grid>
								<ContentPresenter Margin="{TemplateBinding Padding}"
												  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
												  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
												  RecognizesAccessKey="True"
												  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
								<Thumb x:Name="PART_HeaderGripper"
									   HorizontalAlignment="Right"
									   Margin="0,0,-9,0"
									   Style="{StaticResource ColumnHeaderGripperStyle}"/>
							</Grid>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarHoverKey}}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarMouseDownBackgroundGradientKey}}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<!-- Filler column at the right edge of the header row — must be a Style trigger, not inside the ControlTemplate -->
			<Style.Triggers>
				<Trigger Property="Role" Value="Padding">
					<Setter Property="Template">
						<Setter.Value>
							<ControlTemplate TargetType="GridViewColumnHeader">
								<Border Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
										BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
										BorderThickness="0,0,0,1"/>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Trigger>
			</Style.Triggers>
		</Style>

		<!-- ListView style: VS-themed border that does not change on hover or focus -->
		<Style TargetType="ListView">
			<Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"/>
			<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ListView">
						<Border x:Name="Bd"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								SnapsToDevicePixels="true">
							<ScrollViewer Style="{DynamicResource {x:Static GridView.GridViewScrollViewerStyleKey}}"
										  Padding="{TemplateBinding Padding}">
								<ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
							</ScrollViewer>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsGrouping" Value="True">
								<Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- ListViewItem style: VS-themed hover and selection -->
		<Style TargetType="ListViewItem">
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="ContextMenu">
				<Setter.Value>
					<ContextMenu>
						<MenuItem Header="Build"
								  Command="{Binding PlacementTarget.Tag.ContextBuildCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
								  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
							<MenuItem.Icon>
								<imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.BuildSelection}" Width="16" Height="16"/>
							</MenuItem.Icon>
						</MenuItem>
						<MenuItem Header="Rebuild"
								  Command="{Binding PlacementTarget.Tag.ContextRebuildCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
								  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
						<MenuItem Header="Clean"
								  Command="{Binding PlacementTarget.Tag.ContextCleanCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
								  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
						<MenuItem Style="{DynamicResource MenuSeparator}"/>
						<MenuItem Header="Reveal in Solution Explorer"
								  Command="{Binding PlacementTarget.Tag.RevealInSolutionExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
								  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
					</ContextMenu>
				</Setter.Value>
			</Setter>
			<Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListView}}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ListViewItem">
						<Border x:Name="Bd"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								Padding="{TemplateBinding Padding}"
								SnapsToDevicePixels="true">
							<GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}"
												  Content="{TemplateBinding Content}"
												  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarHoverKey}}"/>
							</Trigger>
							<Trigger Property="IsSelected" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}"/>
								<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightTextKey}}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- ContextMenu style: VS-themed with continuous icon gutter -->
		<Style TargetType="ContextMenu">
			<Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarMenuBackgroundGradientBeginKey}}"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarTextActiveKey}}"/>
			<Setter Property="Padding" Value="3"/>
			<Setter Property="Grid.IsSharedSizeScope" Value="True"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ContextMenu">
						<Border Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="4"
								Padding="{TemplateBinding Padding}"
								SnapsToDevicePixels="true">
							<Grid>
								<!-- Continuous icon gutter background -->
								<Border Width="28" HorizontalAlignment="Left" Margin="-3,-3,0,-3"
										CornerRadius="3,0,0,3"
										Background="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarMenuIconBackgroundKey}}"/>
								<StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
							</Grid>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- MenuItem style: VS-themed -->
		<Style TargetType="MenuItem">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarTextActiveKey}}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="MenuItem">
						<Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="true"
								CornerRadius="3" UseLayoutRounding="True">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="28"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="16"/>
								</Grid.ColumnDefinitions>
								<ContentPresenter Grid.Column="0" ContentSource="Icon"
												  HorizontalAlignment="Center" VerticalAlignment="Center"/>
								<ContentPresenter Grid.Column="1" ContentSource="Header"
												  RecognizesAccessKey="True" VerticalAlignment="Center"
												  Margin="6,4"/>
							</Grid>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsHighlighted" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarMouseOverBackgroundBeginKey}}"/>
								<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarTextHoverKey}}"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Button style: VS-themed, borderless with rounded corners -->
		<Style TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarTextActiveKey}}"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd"
								Background="{TemplateBinding Background}"
								BorderThickness="0"
								CornerRadius="3"
								Padding="{TemplateBinding Padding}"
								SnapsToDevicePixels="true">
							<ContentPresenter x:Name="Content"
											  HorizontalAlignment="Center"
											  VerticalAlignment="Center"
											  RecognizesAccessKey="True"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarHoverKey}}"/>
								<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarTextHoverKey}}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarMouseDownBackgroundBeginKey}}"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}"/>
								<Setter TargetName="Content" Property="Opacity" Value="0.4"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<DataTemplate x:Key="ColumnHeaderTemplate">
			<StackPanel Orientation="Horizontal">
				<TextBlock Text="{Binding}" VerticalAlignment="Center"/>
				<TextBlock Text=" ▲" FontSize="9" VerticalAlignment="Center">
					<TextBlock.Visibility>
						<MultiBinding Converter="{StaticResource SortIndicatorVisibilityConverter}" ConverterParameter="Ascending">
							<Binding RelativeSource="{RelativeSource AncestorType=GridViewColumnHeader}" Path="CommandParameter"/>
							<Binding Path="DataContext.SortProperty" RelativeSource="{RelativeSource AncestorType=ListView}"/>
							<Binding Path="DataContext.SortDirection" RelativeSource="{RelativeSource AncestorType=ListView}"/>
						</MultiBinding>
					</TextBlock.Visibility>
				</TextBlock>
				<TextBlock Text=" ▼" FontSize="9" VerticalAlignment="Center">
					<TextBlock.Visibility>
						<MultiBinding Converter="{StaticResource SortIndicatorVisibilityConverter}" ConverterParameter="Descending">
							<Binding RelativeSource="{RelativeSource AncestorType=GridViewColumnHeader}" Path="CommandParameter"/>
							<Binding Path="DataContext.SortProperty" RelativeSource="{RelativeSource AncestorType=ListView}"/>
							<Binding Path="DataContext.SortDirection" RelativeSource="{RelativeSource AncestorType=ListView}"/>
						</MultiBinding>
					</TextBlock.Visibility>
				</TextBlock>
			</StackPanel>
		</DataTemplate>
	</UserControl.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Build status -->
		<TextBlock Grid.Row="0" Margin="10,10,10,0"
				   Text="{Binding BuildStatusText}"
				   Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
				   FontSize="14"
				   TextTrimming="CharacterEllipsis"/>

		<Border Grid.Row="1" Height="1" Margin="10,10,10,0"
				Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"/>

		<Grid Grid.Row="2" Margin="10,10,10,10">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
				<Button Command="{Binding ToggleViewCommand}" Padding="5, 3">
					<StackPanel Orientation="Horizontal">
						<imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.SwitchSourceOrTarget}" Width="16" Height="16"/>
						<TextBlock Text="Switch View" Margin="4,0,0,0" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>

				<Border Width="1" Margin="8,2" Background="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarBorderKey}}"/>

				<Button Command="{Binding BuildProjectCommand}" Padding="5, 3" Margin="0,0,4,0">
					<StackPanel Orientation="Horizontal">
						<imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.BuildSelection}" Width="16" Height="16"/>
						<TextBlock Text="Build" Margin="4,0,0,0" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
				<Button Command="{Binding RebuildProjectCommand}" Padding="5, 3" Margin="0,0,4,0">
					<TextBlock Text="Rebuild" VerticalAlignment="Center"/>
				</Button>
				<Button Command="{Binding CleanProjectCommand}" Padding="5, 3">
					<TextBlock Text="Clean" VerticalAlignment="Center"/>
				</Button>

				<Border Width="1" Margin="8,2" Background="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarBorderKey}}"/>

				<Button Command="{Binding BuildSolutionCommand}" Padding="5, 3" Margin="0,0,4,0">
					<StackPanel Orientation="Horizontal">
						<imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.BuildSolution}" Width="16" Height="16"/>
						<TextBlock Text="Build Solution" Margin="4,0,0,0" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
				<Button Command="{Binding RebuildSolutionCommand}" Padding="5, 3" Margin="0,0,4,0">
					<TextBlock Text="Rebuild Solution" VerticalAlignment="Center"/>
				</Button>
				<Button Command="{Binding CleanSolutionCommand}" Padding="5, 3">
					<TextBlock Text="Clean Solution" VerticalAlignment="Center"/>
				</Button>

				<Border Width="1" Margin="8,2" Background="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarBorderKey}}"/>

				<StackPanel Orientation="Horizontal" Margin="5,0,9,0">
					<imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.StatusError}" Width="16" Height="16"/>
					<TextBlock Text="{Binding ErrorCount}" Margin="4,0,0,0" VerticalAlignment="Center"/>
					<TextBlock Text=" Errors" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}"/>
				</StackPanel>
				<StackPanel Orientation="Horizontal" Margin="5,0,9,0">
					<imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.StatusWarning}" Width="16" Height="16"/>
					<TextBlock Text="{Binding WarningCount}" Margin="4,0,0,0" VerticalAlignment="Center"/>
					<TextBlock Text=" Warnings" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}"/>
				</StackPanel>
				<StackPanel Orientation="Horizontal" Margin="5,0">
					<imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.StatusInformation}" Width="16" Height="16"/>
					<TextBlock Text="{Binding MessageCount}" Margin="4,0,0,0" VerticalAlignment="Center"/>
					<TextBlock Text=" Messages" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}"/>
				</StackPanel>
			</StackPanel>

			<Button Command="{Binding RefreshCommand}" Padding="5, 3" HorizontalAlignment="Right">
				<StackPanel Orientation="Horizontal">
					<imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Refresh}" Width="16" Height="16"/>
					<TextBlock Text="Refresh" Margin="4,0,0,0" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>
		</Grid>

		<!-- List View -->
		<ListView x:Name="ProjectListView" Grid.Row="3" Margin="10,0,10,10"
				  ItemsSource="{Binding SortedProjects}"
				  SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
				  SelectionMode="Single"
				  SizeChanged="ProjectListView_SizeChanged"
				  Visibility="{Binding IsGraphView, Converter={StaticResource BoolToVisibilityInverseConverter}}">
			<ListView.View>
				<GridView ColumnHeaderContainerStyle="{StaticResource SortableColumnHeaderStyle}">
					<GridViewColumn Header="Project Name" HeaderTemplate="{StaticResource ColumnHeaderTemplate}" Width="200">
						<GridViewColumn.HeaderContainerStyle>
							<Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource SortableColumnHeaderStyle}">
								<Setter Property="Command" Value="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=ListView}}"/>
								<Setter Property="CommandParameter" Value="Name"/>
							</Style>
						</GridViewColumn.HeaderContainerStyle>
						<GridViewColumn.CellTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
							</DataTemplate>
						</GridViewColumn.CellTemplate>
					</GridViewColumn>

					<GridViewColumn Header="Build Status" HeaderTemplate="{StaticResource ColumnHeaderTemplate}" Width="110">
						<GridViewColumn.HeaderContainerStyle>
							<Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource SortableColumnHeaderStyle}">
								<Setter Property="Command" Value="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=ListView}}"/>
								<Setter Property="CommandParameter" Value="StatusText"/>
							</Style>
						</GridViewColumn.HeaderContainerStyle>
						<GridViewColumn.CellTemplate>
							<DataTemplate>
								<Border Background="{Binding StatusColor}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
									<TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusTextColor}" FontSize="11" FontWeight="SemiBold"/>
								</Border>
							</DataTemplate>
						</GridViewColumn.CellTemplate>
					</GridViewColumn>

					<GridViewColumn Width="30">
						<GridViewColumn.Header>
							<imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.StatusError}" Width="16" Height="16"/>
						</GridViewColumn.Header>
						<GridViewColumn.HeaderContainerStyle>
							<Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource SortableColumnHeaderStyle}">
								<Setter Property="Command" Value="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=ListView}}"/>
								<Setter Property="CommandParameter" Value="ErrorCount"/>
							</Style>
						</GridViewColumn.HeaderContainerStyle>
						<GridViewColumn.CellTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding ErrorCount}" TextAlignment="Right"/>
							</DataTemplate>
						</GridViewColumn.CellTemplate>
					</GridViewColumn>

					<GridViewColumn Width="30">
						<GridViewColumn.Header>
							<imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.StatusWarning}" Width="16" Height="16"/>
						</GridViewColumn.Header>
						<GridViewColumn.HeaderContainerStyle>
							<Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource SortableColumnHeaderStyle}">
								<Setter Property="Command" Value="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=ListView}}"/>
								<Setter Property="CommandParameter" Value="WarningCount"/>
							</Style>
						</GridViewColumn.HeaderContainerStyle>
						<GridViewColumn.CellTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding WarningCount}" TextAlignment="Right"/>
							</DataTemplate>
						</GridViewColumn.CellTemplate>
					</GridViewColumn>

					<GridViewColumn Width="30">
						<GridViewColumn.Header>
							<imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.StatusInformation}" Width="16" Height="16"/>
						</GridViewColumn.Header>
						<GridViewColumn.HeaderContainerStyle>
							<Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource SortableColumnHeaderStyle}">
								<Setter Property="Command" Value="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=ListView}}"/>
								<Setter Property="CommandParameter" Value="MessageCount"/>
							</Style>
						</GridViewColumn.HeaderContainerStyle>
						<GridViewColumn.CellTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding MessageCount}" TextAlignment="Right"/>
							</DataTemplate>
						</GridViewColumn.CellTemplate>
					</GridViewColumn>

					<GridViewColumn Header="Build Start" HeaderTemplate="{StaticResource ColumnHeaderTemplate}" Width="80">
						<GridViewColumn.HeaderContainerStyle>
							<Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource SortableColumnHeaderStyle}">
								<Setter Property="Command" Value="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=ListView}}"/>
								<Setter Property="CommandParameter" Value="BuildStart"/>
							</Style>
						</GridViewColumn.HeaderContainerStyle>
						<GridViewColumn.CellTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding BuildStart, TargetNullValue='', StringFormat=HH:mm:ss}"/>
							</DataTemplate>
						</GridViewColumn.CellTemplate>
					</GridViewColumn>

					<GridViewColumn Header="Build Finish" HeaderTemplate="{StaticResource ColumnHeaderTemplate}" Width="80">
						<GridViewColumn.HeaderContainerStyle>
							<Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource SortableColumnHeaderStyle}">
								<Setter Property="Command" Value="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=ListView}}"/>
								<Setter Property="CommandParameter" Value="BuildFinish"/>
							</Style>
						</GridViewColumn.HeaderContainerStyle>
						<GridViewColumn.CellTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding BuildFinish, TargetNullValue='', StringFormat=HH:mm:ss}"/>
							</DataTemplate>
						</GridViewColumn.CellTemplate>
					</GridViewColumn>

					<GridViewColumn Header="Duration" HeaderTemplate="{StaticResource ColumnHeaderTemplate}" Width="80">
						<GridViewColumn.HeaderContainerStyle>
							<Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource SortableColumnHeaderStyle}">
								<Setter Property="Command" Value="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=ListView}}"/>
								<Setter Property="CommandParameter" Value="BuildDuration"/>
							</Style>
						</GridViewColumn.HeaderContainerStyle>
						<GridViewColumn.CellTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding BuildDuration, Converter={StaticResource NullableTimeSpanConverter}}"/>
							</DataTemplate>
						</GridViewColumn.CellTemplate>
					</GridViewColumn>

					<GridViewColumn Header="Configuration" HeaderTemplate="{StaticResource ColumnHeaderTemplate}" Width="90">
						<GridViewColumn.HeaderContainerStyle>
							<Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource SortableColumnHeaderStyle}">
								<Setter Property="Command" Value="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=ListView}}"/>
								<Setter Property="CommandParameter" Value="Configuration"/>
							</Style>
						</GridViewColumn.HeaderContainerStyle>
						<GridViewColumn.CellTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding Configuration}" TextTrimming="CharacterEllipsis"/>
							</DataTemplate>
						</GridViewColumn.CellTemplate>
					</GridViewColumn>

					<GridViewColumn Header="Platform" HeaderTemplate="{StaticResource ColumnHeaderTemplate}" Width="80">
						<GridViewColumn.HeaderContainerStyle>
							<Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource SortableColumnHeaderStyle}">
								<Setter Property="Command" Value="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=ListView}}"/>
								<Setter Property="CommandParameter" Value="Platform"/>
							</Style>
						</GridViewColumn.HeaderContainerStyle>
						<GridViewColumn.CellTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding Platform}" TextTrimming="CharacterEllipsis"/>
							</DataTemplate>
						</GridViewColumn.CellTemplate>
					</GridViewColumn>

					<GridViewColumn Header="Project Type" HeaderTemplate="{StaticResource ColumnHeaderTemplate}" Width="90">
						<GridViewColumn.HeaderContainerStyle>
							<Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource SortableColumnHeaderStyle}">
								<Setter Property="Command" Value="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=ListView}}"/>
								<Setter Property="CommandParameter" Value="ProjectType"/>
							</Style>
						</GridViewColumn.HeaderContainerStyle>
						<GridViewColumn.CellTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding ProjectType}" TextTrimming="CharacterEllipsis"/>
							</DataTemplate>
						</GridViewColumn.CellTemplate>
					</GridViewColumn>

					<GridViewColumn x:Name="DependenciesColumn" Header="Dependencies" HeaderTemplate="{StaticResource ColumnHeaderTemplate}" Width="200">
						<GridViewColumn.HeaderContainerStyle>
							<Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource SortableColumnHeaderStyle}">
								<Setter Property="Command" Value="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=ListView}}"/>
								<Setter Property="CommandParameter" Value="DependenciesText"/>
							</Style>
						</GridViewColumn.HeaderContainerStyle>
						<GridViewColumn.CellTemplate>
							<DataTemplate>
								<ItemsControl ItemsSource="{Binding Dependencies, Converter={StaticResource SortByNameConverter}}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<StackPanel Orientation="Horizontal"/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
													BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
													BorderThickness="1"
													CornerRadius="3"
													Padding="4,1"
													Margin="0,1,3,1">
												<TextBlock Text="{Binding Name}" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" FontSize="11"/>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</DataTemplate>
						</GridViewColumn.CellTemplate>
					</GridViewColumn>
				</GridView>
			</ListView.View>
		</ListView>

		<!-- Graph View -->
		<Border Grid.Row="3" Height="1" Margin="10,0,10,10"
				Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
				VerticalAlignment="Top"
				Visibility="{Binding IsGraphView, Converter={StaticResource BoolToVisibilityConverter}}"/>

		<ScrollViewer Grid.Row="3" Margin="10,11,10,10"
					  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
					  Visibility="{Binding IsGraphView, Converter={StaticResource BoolToVisibilityConverter}}">
			<ItemsControl ItemsSource="{Binding GraphRowGroups}" Margin="0">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Orientation="Vertical"/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border Background="{Binding BackgroundBrush}"
								BorderBrush="Transparent"
								BorderThickness="0"
								CornerRadius="5"
								Margin="0,0,0,10"
								Padding="8">
							<ItemsControl ItemsSource="{Binding Nodes}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel Orientation="Horizontal"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<views:ProjectNodeControl Margin="5"/>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
	</Grid>
</UserControl>
